GOOGLE_API_KEY="AQ.Ab8RN6L_dyeh80ysdDt1Wh742FhwwoB_ssphi_lbClkc_re3jw"
GEMINI_MODEL="gemini-3.1-flash-lite"
#gemini-3.1-flash-lite
#gemma-4-26b-a4b-it
#gemini-3-flash-preview

# ── Provider defaults ──
# Gemini Flash Lite is the default per explicit request (2026-08-09). Note the
# earlier default was Claude Sonnet specifically because lite/free-tier models
# were observed to produce sparser, less well-grouped IR diagrams — worth
# knowing if diagram quality regresses. Fallback order survives quota/outage.
PROVIDER_DEFAULT="gemini"
PROVIDER_FALLBACK_ORDER=claude

# ── LLM retry (transient 429/502/503/504 errors) in seconds──
LLM_MAX_RETRIES=1
BACKOFF_BASE=4.0
BACKOFF_MAX=60.0
MAX_CONCURRENT_LLM=5
VIEW_QUALITY_MIN_SCORE=75
#VIEW_LLM_PROVIDER= (optional)

# ── Server ──
APP_TITLE="Draw.io AI Architect"
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=*
SSL_VERIFY=true
MAX_CUSTOM_MESSAGE_LEN=5000

# ── Logging ──
LOG_FORMAT=text
DRAWIO_AGENT_LOG_DIR=logs
LOG_RETENTION_DAYS=5

# ── Draw.io embed ──
DRAWIO_LIB_AWS=mxgraph.aws4
DRAWIO_LIB_GCP=mxgraph.gcp2
DRAWIO_LIB_AZURE=img/lib/azure2

# ── Diagram renderer (MCP) ──
DIAGRAM_RENDERER="auto"
DRAWIO_MCP_URL=https://mcp.draw.io/mcp
DRAWIO_MCP_TIMEOUT=30
DRAWIO_MCP_LIBAVOID=true
# Only set true for ONE restart after changing MCP pick logic or prompts, then back
# to false — leaving it on wipes the icon cache every startup, forcing live MCP
# lookups for every shape and turning misses/timeouts into grey placeholder boxes.
DRAWIO_STYLE_CACHE_RESET=false

ADMIN_PASSWORD="admin123"

