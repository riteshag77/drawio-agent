# ── Provider defaults ──
PROVIDER_DEFAULT="gemini"

# ── LLM retry (transient 429/502/503/504 errors) in seconds──
# 0 = fail fast, no retry — a busy/overloaded model rarely recovers within seconds
LLM_MAX_RETRIES=0
BACKOFF_BASE=4.0
BACKOFF_MAX=60.0

# ── XML repair (corrective LLM pass when deterministic repair leaves structural
# errors) — bounded so a persistently-broken diagram can't loop and burn LLM budget
XML_REPAIR_MAX_ATTEMPTS=1

# ── Server ──
APP_TITLE="Draw.io AI Architect"
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=*
SSL_VERIFY=true
MAX_CUSTOM_MESSAGE_LEN=5000

# ── Logging ──
LOG_FORMAT=text
DRAWIO_AGENT_LOG_DIR=logs
LOG_RETENTION_DAYS=14

# ── Draw.io embed ──
DRAWIO_LIB_AWS=mxgraph.aws4
DRAWIO_LIB_GCP=mxgraph.gcp2
DRAWIO_LIB_AZURE=img/lib/azure2

# ── Diagram renderer (MCP) ──
DIAGRAM_RENDERER="auto"
DRAWIO_MCP_URL=https://mcp.draw.io/mcp
DRAWIO_MCP_TIMEOUT=30
DRAWIO_MCP_LIBAVOID=true
DRAWIO_STYLE_CACHE_RESET=true
